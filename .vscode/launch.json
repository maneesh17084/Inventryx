{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Inventryx: start web app (full data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Inventryx: start web app (starter data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--starter"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Inventryx: generate full dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "inventryx",
      "args": ["generate", "--profile", "full", "--seed", "20261022", "--out", "data/full"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Inventryx: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
